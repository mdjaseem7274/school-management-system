
# Example environment configuration
PORT=3000

# MongoDB connection string - Render par actual value set karna
MONGODB_URI=your-mongodb-connection-string
MONGODB_DB=school

# Render par ek strong random secret set karna
JWT_SECRET=replace-with-a-long-random-secret

# Initial admin credentials - actual values securely configure karna
ADMIN_ID=your-admin-id
ADMIN_PASSWORD=change-this-password
